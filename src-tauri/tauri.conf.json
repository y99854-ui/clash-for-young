{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clash for Young",
  "version": "0.1.0",
  "identifier": "com.joe.clash-for-young",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clash for Young",
        "width": 960,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/mihomo"
    ],
    "resources": {
      "resources/geo/": "geo/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MzM1NUM4NUZFQTU1MTIKUldRU1ZlcGZ5RlV6dHlnellscGZFWWdPU0FYeDZiTittL0ZOVTg5OVBiTkpFWDc2M0U5N0FYR1kK",
      "endpoints": [
        "https://github.com/y99854-ui/clash-for-young/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
